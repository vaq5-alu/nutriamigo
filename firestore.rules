rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Colección pública (solo lectura) para validar unicidad de username antes del Auth
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Reglas para la colección 'users' y sus subcolecciones (logs, chat, etc)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Reglas para 'profiles' (donde se guarda el peso, actividad, meta)
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para 'daily_checkins' (ánimo y energía diaria)
    match /daily_checkins/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
